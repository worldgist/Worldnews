# Copy to .env for local dev. On Vercel, add the same VITE_* variables under
# Project Settings → Environment Variables, then redeploy.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_from_supabase_dashboard

# Server-side import script credentials (never expose these in VITE_* vars)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_from_supabase_dashboard
THENEWS_API_TOKEN=your_thenewsapi_token

# Optional defaults for script behavior
# THENEWS_API_LOCALE=us,gb,ng
# THENEWS_API_LANGUAGE=en
# THENEWS_API_CATEGORIES=politics,tech,business
# THENEWS_API_LIMIT=25
# THENEWS_API_PAGE=1
# THENEWS_API_SORT=published_at
# THENEWS_API_PUBLISHED_ON=2026-05-19
# THENEWS_API_PUBLISHED_AFTER=2026-05-19T00:00:00
# THENEWS_API_PUBLISHED_BEFORE=2026-05-20T00:00:00
# THENEWS_API_SEARCH=
# THENEWS_API_SEARCH_FIELDS=title,description,keywords,main_text

# Edge Function / Scheduler secret to protect cron-triggered import endpoint
LIVE_NEWS_CRON_SECRET=replace_with_long_random_secret
